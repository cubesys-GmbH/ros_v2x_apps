<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>v2x_apps</name>
  <version>1.0.0</version>
  <description>Collection of V2X applications utilizing cube devices</description>
  <author email="apostolos.georgiadis@nfiniity.com">Apostolos Georgiadis</author>
  <maintainer email="apostolos.georgiadis@nfiniity.com">Apostolos Georgiadis</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>vanetza_msgs</depend>
  <depend>etsi_its_cam_msgs</depend>
  <depend>etsi_its_denm_msgs</depend>
  <depend>etsi_its_cpm_ts_msgs</depend>
  <depend>etsi_its_vam_ts_msgs</depend>
  <depend>cube_den_msgs</depend>
  <depend>cube_facility_msgs</depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
